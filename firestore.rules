rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- AUTHENTICATION HELPERS ---
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@kentehaul.com';
    }

    // --- LOGGING & ACTIVITY (WRITE ONLY FOR PUBLIC) ---
    match /activity_log/{logId} {
      allow read: if isAdmin();
      allow create: if true; 
      allow update, delete: if false;
    }

    // --- PUBLIC CONTENT (READ FOR ALL, WRITE FOR ADMIN) ---
    // Firestore ORs every matching rule, so this wildcard also matched
    // /settings/private and its `read: if true` overrode the admin-only block
    // below — publishing kwikApiKey and arkeselApiKey to anyone who asked.
    // The wildcard must exclude `private` explicitly.
    match /settings/{doc} {
      allow read: if doc != 'private';
      allow write: if isAdmin();
    }

    // Private settings (API keys, secrets) — admin only
    match /settings/private {
      allow read, write: if isAdmin();
    }
    
    match /settings/categories {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
      // Customers decrement stock during atomic checkout. Without the direction and
      // floor checks below, any visitor could set any product's stock to any value.
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockQuantity'])
        && request.resource.data.stockQuantity is number
        && request.resource.data.stockQuantity >= 0
        && request.resource.data.stockQuantity < resource.data.stockQuantity
      );
    }
    
    match /gallery/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true; // Public can submit
      allow update, delete: if isAdmin();
    }

    match /feedbacks/{feedbackId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- SENSITIVE COMMERCE DATA (STRICT PROTECTION) ---
    
    match /orders/{orderId} {
      // Admin sees everything. Public can ONLY get their own order if they have the exact ID.
      // We block 'list' queries for non-admins to prevent database scraping.
      allow list: if isAdmin();
      allow get: if true; 
      allow create: if true; 
      allow update, delete: if isAdmin();
    }
    
    match /customers/{phone} {
      // `read` covers both get and list. Locking both to admin broke client login,
      // which getDoc()s customers/{phone} directly (App.jsx handleClientLogin).
      // Split them: single-doc gets are public, list queries stay admin-only so the
      // CRM can't be scraped.
      allow get: if true;
      allow list: if isAdmin();
      allow create: if true;
      // Checkout writes profile stubs, and signup later claims a stub by setting
      // passwordHash on it. So allow writing passwordHash only when the doc has
      // none yet — otherwise anyone could overwrite an existing account's hash.
      allow update: if isAdmin()
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['passwordHash'])
        || !('passwordHash' in resource.data);
      allow delete: if isAdmin();
    }

    match /wishlists/{clientId} {
      allow read: if isAdmin();
      allow write: if true; 
    }
    
    match /mail/{mailId} {
      // Trigger Email collection: Write only for system, never readable by public.
      allow read, update, delete: if false; 
      allow create: if true; 
    }
    
    // --- PARTNERSHIPS ---
    match /partnerships/{id} {
        allow read: if isAdmin();
        allow create: if true;
        allow update, delete: if isAdmin();
    }

    // --- SALE ANNOUNCEMENT SUBSCRIBERS ---
    // Public "notify me" opt-in ahead of a scheduled sale. Contact details are
    // personal data, so this mirrors the customers/mail pattern: anyone can add
    // themselves, nobody but admin (and the sending Cloud Function, which runs
    // with admin privileges) can read the list back.
    match /sale_subscribers/{id} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // --- INVENTORY (goods staged before they reach the shop) ---
    // Purely an internal admin workflow — nothing here is ever read by a customer.
    match /inventory/{id} {
      allow read, write: if isAdmin();
    }

    // --- STOCK LEDGER (append-only audit trail) ---
    // Written both by customer checkout (alongside the stockQuantity decrement —
    // see App.jsx) and by admin stock edits, so create must stay public the same
    // way the products stockQuantity update already is. Never updated or deleted:
    // an audit log that can be edited after the fact isn't an audit log.
    match /stock_ledger/{id} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if false;
    }

    // --- DEFAULT DENY ---
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
